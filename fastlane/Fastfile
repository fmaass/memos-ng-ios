# Headless TestFlight pipeline. Auth is an App Store Connect API key (no Apple ID / 2FA),
# and signing runs in a dedicated keychain so codesign never touches the GUI login keychain
# (the login keychain is unreachable over SSH -> errSecInternalComponent; that is the whole
# reason this pipeline exists rather than `xcodebuild archive` over ssh).

require "shellwords"
require "spaceship"
require File.expand_path("lib/asc_readback", __dir__)
require File.expand_path("lib/dsym_store", __dir__)
require File.expand_path("lib/release_notes", __dir__)
require File.expand_path("lib/timed_probe", __dir__)

default_platform(:ios)

APP_ID   = "live.discomarder.memosng"
EXT_ID   = "live.discomarder.memosng.share"
TEAM_ID  = "Y2JQ4VAF85"
SCHEME   = "MemosNG"
PROJECT  = "MemosNG.xcodeproj"
KEYCHAIN = "memosng-ci.keychain-db"
KEYPATH  = File.expand_path("~/Library/Keychains/#{KEYCHAIN}")
ROOT     = File.expand_path("..", __dir__)
ARCHIVE  = "#{ROOT}/build/MemosNG.xcarchive"
IPA      = "#{ROOT}/build/MemosNG.ipa"
GROUP    = "household"
NOTES    = "#{ROOT}/fastlane/TESTFLIGHT_NOTES.md"

# Off-host first: merkur's build dirs are reaped for disk and its disk is the single point of
# failure, so the primary store is the NAS. lexosaurus is the local fallback and says so loudly.
DSYM_STORES     = [["janus", "/Users/Shared/nas/janus"], ["lexosaurus", "/Volumes/lexosaurus"]].freeze
DSYM_SUBPATH    = "memos-ng-ios/dSYMs"
ATTACH_TIMEOUT  = 300
ATTACH_INTERVAL = 20
# A store probe answers in milliseconds when the mount is healthy; anything past this is a hang.
DSYM_PROBE_TIMEOUT = 10

def api_key
  app_store_connect_api_key(
    key_id:       ENV.fetch("ASC_KEY_ID"),
    issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house:     false,
  )
end

# MEMNG-195: a merkur-wide mutex shared with img-manager-ios's pipeline (fastlane/Fastfile there,
# WP8 P0b fold item 7) around keychain-search-list mutation, certificate/profile preparation and
# the archive itself -- two releases racing the same host's keychain search list or DerivedData
# can select the wrong signing identity or exhaust disk. `flock` is cooperative: this is a real
# mutex only because BOTH Fastfiles take the exact same default path, so the default here
# (~/.release-lock) must not drift from img-manager-ios's. A bash 3.2 build host has no flock(1)
# (see mac-gate.sh's own comment on that constraint), so this uses Ruby's File#flock directly.
RELEASE_LOCK_PATH = File.expand_path("~/.release-lock") # non-overridable: an override would defeat the cross-pipeline mutex

def with_release_lock
  UI.message("release lock: waiting on #{RELEASE_LOCK_PATH} (blocks until no other release -- " \
             "this or img-manager-ios's -- holds it)")
  File.open(RELEASE_LOCK_PATH, File::CREAT | File::RDWR, 0o644) do |lock|
    acquired_at = Time.now
    lock.flock(File::LOCK_EX)
    lock.write("pid=#{Process.pid} project=memos-ng-ios lane=archive_ipa at=#{Time.now.utc}\n")
    lock.flush
    UI.message("release lock: acquired after #{(Time.now - acquired_at).round(1)}s")
    begin
      yield
    ensure
      lock.flock(File::LOCK_UN)
      UI.message("release lock: released")
    end
  end
end

def prepare_signing(key)
  kc_pw = ENV.fetch("CI_KEYCHAIN_PW")
  unless File.exist?(KEYPATH)
    create_keychain(
      name: KEYCHAIN, password: kc_pw, default_keychain: false,
      unlock: true, timeout: 7200, lock_when_sleeps: false, add_to_search_list: true,
    )
  end
  unlock_keychain(path: KEYPATH, password: kc_pw)

  cert(api_key: key, keychain_path: KEYPATH, keychain_password: kc_pw,
       output_path: "#{ROOT}/fastlane/certs")

  prof_app = get_provisioning_profile(
    api_key: key, app_identifier: APP_ID, force: true,
    output_path: "#{ROOT}/fastlane/profiles", filename: "app.mobileprovision",
  )
  prof_ext = get_provisioning_profile(
    api_key: key, app_identifier: EXT_ID, force: true,
    output_path: "#{ROOT}/fastlane/profiles", filename: "ext.mobileprovision",
  )

  # The archive step signs each target directly, so the profile must be written into the
  # project per target -- export_options only governs the (unused) export step.
  update_code_signing_settings(
    use_automatic_signing: false, path: PROJECT, team_id: TEAM_ID,
    targets: ["MemosNG"], code_sign_identity: "Apple Distribution", profile_name: prof_app,
  )
  update_code_signing_settings(
    use_automatic_signing: false, path: PROJECT, team_id: TEAM_ID,
    targets: ["MemosShare"], code_sign_identity: "Apple Distribution", profile_name: prof_ext,
  )
end

# The shipped numbers are read off the archive rather than off project.yml: that is what was
# actually built, so the dSYM folder name and the ASC read-back cannot drift from the upload.
def archive_version(archive)
  plist = "#{archive}/Products/Applications/#{SCHEME}.app/Info.plist"
  UI.user_error!("no Info.plist at #{plist}") unless File.exist?(plist)
  version = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' '#{plist}'", log: false).strip
  build_number = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' '#{plist}'", log: false).strip
  UI.user_error!("could not read version/build from #{plist}") if version.empty? || build_number.empty?
  [version, build_number]
end

# MEMNG-571: the build's "What to Test" text, keyed by the numbers the archive carries. Asked for
# before the dSYM copy and the upload, so a missing or empty section stops the lane while nothing
# has left the host yet.
def testflight_changelog(version, build_number)
  status, text = ReleaseNotes.load(NOTES, version: version, build: build_number)
  UI.user_error!("release notes REFUSED for #{version} (#{build_number}): #{text}") unless status == :ok
  UI.message("release notes for #{version} (#{build_number}): #{text.length} characters from #{NOTES}")
  text
end

# Listing is what triggers janus's autofs mount, so probe by listing rather than by File.exist?.
# The listing runs OUT OF PROCESS (see TimedProbe): both of these calls are the ones that block
# forever on a hung NFS hard mount, and a release lane that stalls on a dead NAS never reaches the
# fallback that exists precisely for that case.
def dsym_store_reachable?(root)
  quoted = Shellwords.escape(root)
  TimedProbe.ok?("/bin/ls #{quoted} && /bin/test -w #{quoted}", seconds: DSYM_PROBE_TIMEOUT)
end

# The Spaceship half of the read-back: fetch, hand the facts to the pure verdict, return it.
def asc_attach_status(version:, build_number:)
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  return [:fail, "App Store Connect has no app #{APP_ID}"] if app.nil?

  group = app.get_beta_groups.find { |candidate| candidate.name == GROUP }
  return [:fail, "App Store Connect has no beta group #{GROUP.inspect}"] if group.nil?

  build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number).first
  AscReadback.verdict(
    build: build,
    group_build_ids: group.fetch_builds.map(&:id),
    beta_detail: build && build.build_beta_detail,
    group_name: GROUP,
  )
end

platform :ios do
  # Xcode 26.6's `-exportArchive` CreateIPA step fails with an opaque "Copy failed" (the app
  # itself copies fine with ditto), so we archive only and assemble the IPA by hand from the
  # already-distribution-signed .app -- a plain Payload/ zip is a valid App Store IPA.
  desc "Archive and package a signed app-store IPA (no upload)"
  lane :archive_ipa do
    key = api_key
    with_release_lock do
      prepare_signing(key)
      sh("rm -rf '#{ARCHIVE}' '#{IPA}' '#{ROOT}/build/Payload'")
      build_app(
        project: PROJECT, scheme: SCHEME, configuration: "Release",
        skip_package_ipa: true, clean: true,
        archive_path: ARCHIVE, derived_data_path: "#{ROOT}/build/dd",
      )
    end
    app = "#{ARCHIVE}/Products/Applications/MemosNG.app"
    sh("mkdir -p '#{ROOT}/build/Payload' && ditto '#{app}' '#{ROOT}/build/Payload/MemosNG.app' && " \
       "cd '#{ROOT}/build' && /usr/bin/zip -qry MemosNG.ipa Payload")
    UI.success("IPA ready: #{IPA}")
    IPA
  end

  # Builds 7, 8 and 9 shipped with no preserved symbols: build/ is reaped for disk and nothing
  # ever copied the dSYMs out, so their crash reports can never be symbolicated. This lane fails
  # loudly rather than skipping -- a silent skip is the whole defect.
  desc "Copy an archive's dSYMs into the off-host store and print their UUIDs"
  lane :preserve_dsyms do |options|
    archive = (options[:archive] || ARCHIVE).to_s
    UI.user_error!("preserve_dsyms: no archive at #{archive}") unless Dir.exist?(archive)

    bundles = Dir.glob(File.join(archive, "dSYMs", "*.dSYM")).sort
    UI.user_error!("preserve_dsyms: #{archive}/dSYMs holds no .dSYM bundle") if bundles.empty?

    supplied_version = options[:version].to_s
    supplied_build = options[:build].to_s
    archive_v = ""
    archive_b = ""
    archive_v, archive_b = archive_version(archive) if supplied_version.empty? || supplied_build.empty?
    version, build_number = DsymStore.release_label(
      version: supplied_version, build: supplied_build,
      archive_version: archive_v, archive_build: archive_b,
    )
    UI.user_error!("preserve_dsyms: could not resolve a version/build to file under") if version.empty? || build_number.empty?

    status, root, message = DsymStore.choose(DSYM_STORES) { |candidate| dsym_store_reachable?(candidate) }
    UI.user_error!("preserve_dsyms: #{message}") if status == :none
    status == :fallback ? UI.important(message) : UI.message(message)

    dest = File.join(root, DSYM_SUBPATH, "#{version}-#{build_number}")
    sh("mkdir -p '#{dest}'")
    bundles.each { |bundle| sh("ditto '#{bundle}' '#{dest}/#{File.basename(bundle)}'") }

    copied = Dir.glob(File.join(dest, "*.dSYM")).sort
    UI.user_error!("preserve_dsyms: nothing landed in #{dest}") if copied.empty?

    copied.each do |bundle|
      sh("dwarfdump --uuid '#{bundle}'", log: false).each_line do |line|
        UI.important(line.rstrip) unless line.strip.empty?
      end
    end
    UI.success("dSYMs preserved for #{version} (#{build_number}): #{copied.size} bundle(s) in #{dest}")
    dest
  end

  # `upload_to_testflight` exits 0 on its own success, which is not the same thing as the
  # household being able to see the build -- so the release reads App Store Connect back and
  # fails when the attach did not land. 1.0.2 (8) and 1.0.3 (9) were both found unattached by
  # hand, days later.
  desc "Read App Store Connect back: the build is VALID, attached to household, and in testing"
  lane :verify_attach do |options|
    version = options[:version].to_s
    build_number = options[:build].to_s
    UI.user_error!("verify_attach needs version:<marketing> build:<number>") if version.empty? || build_number.empty?

    api_key # also installs the Spaceship token this read-back queries with
    deadline = Time.now + ATTACH_TIMEOUT
    message = "no read-back was attempted"

    loop do
      unless AscReadback.may_request?(now: Time.now, deadline: deadline)
        UI.user_error!("ASC read-back TIMED OUT after #{ATTACH_TIMEOUT}s for " \
                       "#{version} (#{build_number}): #{message}")
      end

      status, message = asc_attach_status(version: version, build_number: build_number)
      UI.user_error!("ASC read-back FAILED for #{version} (#{build_number}): #{message}") if status == :fail

      if status == :ok
        UI.success("ASC read-back OK for #{version} (#{build_number}): #{message}")
        break
      end

      wait = AscReadback.next_wait(now: Time.now, deadline: deadline, interval: ATTACH_INTERVAL)
      if wait.nil?
        UI.user_error!("ASC read-back TIMED OUT after #{ATTACH_TIMEOUT}s for " \
                       "#{version} (#{build_number}): #{message}")
      end
      UI.message("ASC read-back not settled yet: #{message} - retrying in #{wait}s")
      sleep(wait)
    end
  end

  # The same derivation `beta` runs, with nothing built or uploaded: a release checks its notes
  # section before it spends an archive on finding it missing.
  desc "Print the TestFlight notes a version and build would upload with"
  lane :testflight_notes do |options|
    version = options[:version].to_s
    build_number = options[:build].to_s
    UI.user_error!("testflight_notes needs version:<marketing> build:<number>") if version.empty? || build_number.empty?

    puts(testflight_changelog(version, build_number))
  end

  desc "Build and upload to TestFlight (headless)"
  lane :beta do
    archive_ipa
    version, build_number = archive_version(ARCHIVE)
    changelog = testflight_changelog(version, build_number)
    preserve_dsyms(archive: ARCHIVE, version: version, build: build_number)
    # No skip_waiting here: leaving before ASC finishes processing means the groups:
    # assignment silently never runs, and with an internal group that cannot be
    # hasAccessToAllBuilds (the API refuses to enable it post-creation), an unattached
    # build is INVISIBLE to every tester -- 1.0.2 (8) sat processed and unseen until a
    # manual API attach. Waiting costs minutes and makes distribution real.
    # submit_beta_review defaults to TRUE and posts a Beta App Review submission -- an
    # EXTERNAL-testing requirement the internal household group neither needs nor satisfies
    # (no beta description is filled in), so the lane died there AFTER processing and BEFORE
    # the group assign, leaving 1.0.3 (9) processed and unattached until a manual API attach.
    upload_to_testflight(
      api_key: api_key, ipa: IPA, groups: [GROUP],
      distribute_external: false, submit_beta_review: false, changelog: changelog,
    )
    verify_attach(version: version, build: build_number)
  end
end
